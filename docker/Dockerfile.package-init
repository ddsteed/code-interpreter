# Package Init Dockerfile
# Builds Python, Node, Bun, and Bash runtime packages for the NsJail sandbox.
# Runs as a Kubernetes init job to populate the packages PVC.
#
# Usage:
#   docker build -f docker/Dockerfile.package-init -t codeapi-package-init .
#   docker run -v packages:/pkgs codeapi-package-init

FROM docker.m.daocloud.io/library/debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

COPY docker/apt-install.sh /usr/local/bin/apt-install
RUN chmod +x /usr/local/bin/apt-install

# 换阿里云 apt 源（国内 deb.debian.org 慢/不稳）
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null; \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null; true

RUN apt-install \
    curl unzip wget ca-certificates \
    build-essential libssl-dev libffi-dev libsqlite3-dev \
    zlib1g-dev libbz2-dev libreadline-dev libncurses5-dev \
    tk-dev xz-utils libcurl4-openssl-dev libfontconfig1-dev \
    libudunits2-dev libpng-dev libxml2-dev libcairo2-dev \
    libfreetype6-dev

RUN mkdir -p /pkgs

COPY docker/package-init.sh /package-init.sh
COPY javascript-packages.txt /javascript-packages.txt
RUN chmod +x /package-init.sh

CMD ["/package-init.sh"]
